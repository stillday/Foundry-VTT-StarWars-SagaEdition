<section class="tab scrollable{{#if tab.active}} active{{/if}}" data-group="{{tab.group}}" data-tab="{{tab.id}}">
    <header class="change-list-header flexrow">
        <div class="key">{{localize "EFFECT.FIELDS.name.label"}}</div>
        <div class="mode">{{localize "EFFECT.TabLinks"}}</div>
        <div class="change-controls"></div>
    </header>
    <ol class="change-list item-list">
        {{#each links as |link|}}
            <li class="flexrow item change" data-name="{{link.name}}">
                <div class="key">{{link.name}}</div>
                <div class="mode">{{link.type}}</div>
                <div class="change-controls">
                    <a class="change-control" data-action="link-control" data-action-type="delete"
                       data-name="{{link.name}}" data-uuid="{{link.uuid}}"><i class="fas fa-trash"></i></a>
                </div>
            </li>
        {{/each}}
    </ol>
</section>
