<section class="tab scrollable{{#if tab.active}} active{{/if}}" data-group="{{tab.group}}" data-tab="{{tab.id}}">
    <div class="item-pane">
        <div class="left-sidebar sidebar spacer">
            {{#if document.hasDisable}}
                {{formGroup fields.disabled value=source.disabled rootId=rootId stacked=true}}
            {{/if}}
            {{formGroup fields.tint value=source.tint rootId=rootId placeholder="#ffffff" stacked=true}}
        </div>
        <div class="middle-right-sidebar spacer">
            <div class="flex-col">
                <fieldset>
                    <legend>{{localize "EFFECT.TABS.details"}}</legend>
                    {{#if isActorEffect}}
                        {{formGroup fields.origin value=source.origin rootId=rootId disabled=true}}
                    {{else if isItemEffect}}
                        {{formGroup fields.transfer value=source.transfer rootId=rootId}}
                    {{/if}}
                    {{formGroup fields.statuses value=source.statuses options=statuses sort=true rootId=rootId
                                classes="statuses"}}
                    {{formGroup fields.showIcon value=source.showIcon options=showIconOptions rootId=rootId}}
                </fieldset>
                <fieldset class="swse-description">
                    <legend>{{localize "EFFECT.FIELDS.description.label"}}</legend>
                    {{!-- `toggled` keeps the editor collapsed until the pencil is clicked, so a
                          submitOnChange re-render cannot destroy an active editing session. --}}
                    <prose-mirror name="flags.swse.description" value="{{swseDescription}}" toggled
                                  data-document-uuid="{{document.uuid}}"
                                  {{#unless editable}}disabled{{/unless}}></prose-mirror>
                </fieldset>
            </div>
        </div>
    </div>
</section>
