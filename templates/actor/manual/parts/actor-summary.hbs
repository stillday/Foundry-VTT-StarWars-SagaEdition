<!--TODO find a spot for the portrait -->
<div class="summary-header swse">
    <div class="name"><label for="name">Name</label>
        <h2><input class="plain" name="name" type="text" value="{{actor.name}}"
                   placeholder=""/></h2></div>
    <div class="player"><label for="player">{{localize "SWSE.UI.LabelPlayer"}}</label>
        <h2><input class="plain" name="system.player" type="text"
                   value="{{actor.system.player}}" placeholder=""/></h2></div>
    <div class="classes"><label for="classes">{{localize "SWSE.UI.LabelClasses"}}</label>
        <input class="plain" name="system.manual.classSummary" type="text" value="{{actor.system.manual.classSummary}}"
               placeholder=""/>
    </div>
    <div class="level"><label for="level">{{localize "SWSE.UI.LabelLevel"}}</label>
        <input class="plain" name="system.manual.levelSummary" type="number" value="{{actor.system.manual.levelSummary}}"
               placeholder=""/>
    </div>

    <div class="species">

        <label for="species">{{localize "SWSE.UI.LabelSpecies"}}</label>
        <input class="plain" name="system.manual.species" type="text" value="{{actor.system.manual.species}}"
               placeholder=""/>
    </div>
    <div class="sex">
        <label for="gender">{{localize "SWSE.UI.LabelGender"}}</label>

        <input class="plain" name="system.gender" type="text" value="{{actor.system.gender}}"
               placeholder=""/>

    </div>
    <div class="age">
        <label for="age">{{localize "SWSE.UI.LabelAge"}}</label>

        <input class="plain" name="system.age" type="text" value="{{actor.system.age}}"
               placeholder=""/>
    </div>
    <div class="height"><label for="height">{{localize "SWSE.UI.LabelHeight"}}</label>
        <h2><input class="plain" name="system.height" type="text"
                   value="{{actor.system.height}}" placeholder="Height"/></h2></div>
    <div class="weight"><label for="weight">{{localize "SWSE.UI.LabelWeight"}}</label>
        <h2><input class="plain" name="system.weight" type="text"
                   value="{{actor.system.weight}}" placeholder="Weight"/></h2></div>
    <div class="destiny">
        <label>{{localize "SWSE.UI.LabelDestinyOrBackground"}}</label>

        <input class="plain" name="system.manual.destiny" type="text" value="{{actor.system.manual.destiny}}"
               placeholder=""/>
    </div>
    <div class="experience"><label for="experience">{{localize "SWSE.UI.LabelXP"}}</label>
        <h2><input class="plain" name="system.experience" type="number"
                   value="{{actor.system.experience}}" placeholder="0"/></h2>
    </div>
</div>