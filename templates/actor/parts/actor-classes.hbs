<div class="flexrow">
    <h2><label class="resource-label">Classes
    </label></h2>
    <button type="button" class="flex-0" style="flex-basis:180px" data-action="gm-bonus">{{localize "SWSE.UI.BtnAddGMBonus"}}</button>
</div>
<table class="fixed">
    <thead>
    <tr>
        <th></th>
        <th>{{localize "SWSE.UI.LabelClass"}}</th>
        {{#unless actor.isFollower}}
            <th>{{localize "SWSE.UI.ColClassHP"}}</th>
            <th>{{localize "SWSE.UI.ColRerollHP"}}</th>
            <th>{{localize "SWSE.UI.ColAttrBonusHP"}}</th>
            <th>{{localize "SWSE.UI.ColTotalHP"}}</th>
        {{/unless}}
        <th>
            <a data-action="compendium" data-type="Item" data-filter="-type:class"
               title="{{localize "Open Compendium"}}"><i class="fas fa-folder-plus"></i></a></th>
    </tr>
    </thead>
    <tbody>
    {{#each actor.classes as |class id|}}
        <tr class="charclass item" data-item-id="{{class.id}}">
            <td class="item-image"><img src="{{class.img}}" title="{{class.name}}" width="24"
                                        height="24" alt="{{class.name}}"/></td>
            <td><h4 class="item-name">{{class.name}}</h4></td>
            {{#unless ../actor.isFollower}}
                <td><span class="text-box {{#if class.canRerollHealth}}item-action short{{/if}} center"
                          data-action="update-level-attribute"
                          data-context="health"
                          data-item="{{class.id}}" data-attribute="rolledHp" data-level="{{class.classLevel}}"
                          data-dtype="Number">{{class.classLevelHealth}}</span>
                </td>
                <td>
                    {{#if class.canRerollHealth}}
                        <a class="rollable" title="Re-roll {{class.levelUpHitPoints}}" data-context="health"
                           data-item="{{class.id}}" data-item-attribute="rolledHp" data-level="{{class.classLevel}}"
                           data-roll="{{class.levelUpHitPoints}}"><i class="fas fa-dice"></i>
                        </a>{{/if}}</td>
                {{!-- system.attributes was renamed to system.abilities in the DataModel port
                      (AbilityFields.migrateData), so both cells rendered empty. --}}
                <td>{{../actor.system.abilities.con.mod}}</td>
                <td>{{sum class.classLevelHealth ../actor.system.abilities.con.mod}}</td>
            {{/unless}}
            <td class="item-controls">
                <a data-action="view" class="item-control" title="{{localize 'SWSE.UI.TitleViewClassDesc'}}"><i
                        class="fas fa-edit"></i></a>

                {{#unless ../actor.isFollower}}
                    <a class="item-control item-duplicate" title="{{localize 'SWSE.UI.TitleCopyClass'}}"><i
                            class="fas fa-plus"></i></a>

                {{/unless}}
                {{#if class.isLatest}}
                    <a data-action="remove-class-level" title="{{localize 'SWSE.UI.TitleDeleteClass'}}"><i
                            class="fas fa-trash"></i></a>{{/if}}
            </td>
        </tr>
    {{/each}}

    {{#unless actor.isFollower}}
        <tr>
            <td></td>
            <td></td>
            <td></td>
            <td></td>
            <td title="these bonuses come from feats, traits, and equipped items.">{{localize "SWSE.UI.LabelOtherBonuses"}}
            </td>
            <td> {{actor.health.other}}</td>
            <td></td>
        </tr>
        <tr>
            <td></td>
            <td></td>
            <td></td>
            <td></td>
            <td></td>
            <td>{{actor.health.max}}</td>
            <td></td>
        </tr>
    {{/unless}}
    </tbody>
</table>

{{#if actor.poorlyFormattedClasses}}

    <div>{{actor.poorlyFormattedClasses}}</div>
{{/if}}