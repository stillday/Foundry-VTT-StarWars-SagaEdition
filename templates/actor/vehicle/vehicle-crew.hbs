<div class="panel flex-row">
    {{#if actor.crew.hasCrewQuality}}
        <div class="crew-quality medium labeled-input">
            <label class="resource-label" for="crew-quality">Crew Quality</label>
            {{!-- The schema field is system.crewQuality (a StringField restricted to
                  CREW_QUALITIES, read by CrewDelegate); system.crewQuality.quality is the pre DataModel
                  path and both the name and the #select argument were still using it, so the dropdown
                  never showed the stored quality and never saved a new one. --}}
            <select id="crew-quality" name="system.crewQuality">
                {{#select actor.system.crewQuality}}
                    <option value="Untrained">Untrained</option>
                    <option value="Normal">Normal</option>
                    <option value="Skilled">Skilled</option>
                    <option value="Expert">Expert</option>
                    <option value="Ace">Ace</option>
                {{/select}}
            </select>
        </div>
    {{/if}}

    {{#if actor.crew.hasAstromechSlot}}
        <div>
            <label class="resource-label" for="hasAstromech">Includes Astromech
            </label>
                <input type="checkbox" id="hasAstromech" name="system.hasAstromech" {{#if actor.system.hasAstromech}}
                       checked="isChecked"{{/if}}/>
        </div>
    {{/if}}
</div>