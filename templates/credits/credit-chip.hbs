<div>
    <label>Credits
        <input type="number" name="system.credits" value="{{actor.credits}}">
    </label>
    <a data-action="credit" data-action-type="add"
       title="{{localize 'SWSE.UI.TitleAddCredits'}}"><i
            class="fas fa-plus"></i></a>
    <a data-action="credit" data-action-type="sub"
       title="{{localize 'SWSE.UI.TitleSubtractCredits'}}"><i
            class="fas fa-minus"></i></a>
    <a data-action="credit" data-action-type="transfer"
       title="{{localize 'SWSE.UI.TitleTransferCredits'}}"><i
            class="fas fa-people-arrows"></i></a>
</div>